generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_POSTGRES_URL")
}

enum UserRole {
  CLIENT
  ADMIN
}

enum OrderStatus {
  NEW
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELED
}

enum PaymentMethod {
  COD
  CARD_TRANSFER
}

enum PromoCodeType {
  GENERAL
  PERSONAL
}

enum PromoCodeDiscountType {
  PERCENT
}

enum SubcategoryFieldType {
  TEXT
  NUMBER
  TEXTAREA
  SELECT
  MULTI_SELECT
  BOOLEAN
}

enum ProductAvailability {
  IN_STOCK
  OUT_OF_STOCK
}

enum ProductOptionDisplayType {
  BUTTONS
  IMAGE_SWATCH
  SELECT
}

enum ContactRequestStatus {
  NEW
  IN_PROGRESS
  DONE
  SPAM
}

enum BlogPostStatus {
  DRAFT
  PUBLISHED
}

enum ReviewType {
  STORE
  PRODUCT
}

model User {
  id                 String           @id @default(cuid())
  email              String           @unique
  passwordHash       String?
  role               UserRole         @default(CLIENT)
  firstName          String?
  lastName           String?
  phone              String?
  isActive           Boolean          @default(true)
  emailVerified      DateTime?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  accounts           Account[]
  sessions           Session[]
  addresses          Address[]
  orders             Order[]
  wishlistItems      WishlistItem[]
  assignedPromoCodes PromoCode[]      @relation("AssignedPromoCodes")
  promoCodeUsages    PromoCodeUsage[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Category {
  id             String        @id @default(cuid())
  name           String        @unique
  slug           String        @unique
  image          String?
  description    String?
  sortOrder      Int           @default(0)
  isActive       Boolean       @default(true)
  seoTitle       String?
  seoDescription String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  subcategories  Subcategory[]
  products       Product[]

  @@index([sortOrder])
  @@index([isActive])
}

model Subcategory {
  id             String             @id @default(cuid())
  categoryId     String
  name           String
  slug           String
  description    String?
  sortOrder      Int                @default(0)
  isActive       Boolean            @default(true)
  seoTitle       String?
  seoDescription String?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  category       Category           @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  fields         SubcategoryField[]
  products       Product[]

  @@unique([categoryId, name])
  @@unique([categoryId, slug])
  @@index([categoryId, sortOrder])
}

model Brand {
  id             String    @id @default(cuid())
  name           String
  slug           String
  description    String?
  seoTitle       String?
  seoDescription String?
  sortOrder      Int       @default(0)
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  products       Product[]

  @@unique([name])
  @@unique([slug])
  @@index([sortOrder])
  @@index([isActive])
}

model SubcategoryField {
  id            String                   @id @default(cuid())
  subcategoryId String
  label         String
  key           String
  type          SubcategoryFieldType
  isRequired    Boolean                  @default(false)
  isActive      Boolean                  @default(true)
  sortOrder     Int                      @default(0)
  helpText      String?
  isFilterable  Boolean                  @default(false)
  createdAt     DateTime                 @default(now())
  updatedAt     DateTime                 @updatedAt
  subcategory   Subcategory              @relation(fields: [subcategoryId], references: [id], onDelete: Cascade)
  options       SubcategoryFieldOption[]
  productValues ProductFieldValue[]

  @@unique([subcategoryId, key])
  @@index([isActive])
  @@index([subcategoryId, sortOrder])
}

model SubcategoryFieldOption {
  id         String              @id @default(cuid())
  fieldId    String
  label      String
  value      String
  sortOrder  Int                 @default(0)
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt
  field      SubcategoryField    @relation(fields: [fieldId], references: [id], onDelete: Cascade)
  valuesUsed ProductFieldValue[]

  @@unique([fieldId, value])
  @@index([fieldId, sortOrder])
}

model Product {
  id                 String              @id @default(cuid())
  categoryId         String
  subcategoryId      String
  brandId            String?
  title              String
  slug               String              @unique
  description        String?             @db.Text
  price              Decimal             @db.Decimal(10, 2)
  availability       ProductAvailability @default(IN_STOCK)
  isActive           Boolean             @default(true)
  isFeaturedNew      Boolean             @default(false)
  isFeaturedSale     Boolean             @default(false)
  isFeaturedHit      Boolean             @default(false)
  isFeaturedDiscount Boolean             @default(false)
  seoTitle           String?
  seoDescription     String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  category           Category            @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  subcategory        Subcategory         @relation(fields: [subcategoryId], references: [id], onDelete: Restrict)
  brand              Brand?              @relation(fields: [brandId], references: [id], onDelete: SetNull)
  images             ProductImage[]
  options            ProductOption[]
  reviews            Review[]
  fieldValues        ProductFieldValue[]
  orderItems         OrderItem[]
  wishlistItems      WishlistItem[]

  @@index([categoryId])
  @@index([subcategoryId])
  @@index([brandId])
  @@index([isActive])
  @@index([availability])
}

model ProductImage {
  id        String   @id @default(cuid())
  productId String
  url       String
  publicId  String
  alt       String?
  sortOrder Int      @default(0)
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, sortOrder])
}

model ProductOption {
  id              String                   @id @default(cuid())
  productId       String
  name            String
  isImageRequired Boolean                  @default(true)
  displayType     ProductOptionDisplayType @default(IMAGE_SWATCH)
  sortOrder       Int                      @default(0)
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt
  product         Product                  @relation(fields: [productId], references: [id], onDelete: Cascade)
  values          ProductOptionValue[]

  @@unique([productId, name])
  @@index([productId])
  @@index([productId, sortOrder])
}

model ProductOptionValue {
  id              String        @id @default(cuid())
  productOptionId String
  label           String
  slug            String?       @unique
  titleOverride   String?
  seoTitle        String?
  seoDescription  String?
  image           String?
  imagePublicId   String?
  sortOrder       Int           @default(0)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  productOption   ProductOption @relation(fields: [productOptionId], references: [id], onDelete: Cascade)

  @@unique([productOptionId, label])
  @@index([productOptionId])
  @@index([productOptionId, sortOrder])
}

model Banner {
  id        String   @id @default(cuid())
  title     String
  imageUrl  String
  targetUrl String
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
  @@index([sortOrder])
}

model ContentPage {
  id                String   @id @default(cuid())
  title             String
  slug              String   @unique
  excerpt           String?
  contentJson       Json?
  contentHtml       String?  @db.Text
  heroImage         String?
  heroImagePublicId String?
  seoTitle          String?
  seoDescription    String?
  seoImage          String?
  seoImagePublicId  String?
  isActive          Boolean  @default(true)
  showInHeader      Boolean  @default(false)
  showInFooter      Boolean  @default(true)
  sortOrder         Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([isActive])
  @@index([showInFooter, sortOrder])
  @@index([showInHeader, sortOrder])
}

model ContactPageSettings {
  id                    String   @id @default(cuid())
  title                 String   @default("Контакти")
  subtitle              String?
  workSchedule          String?
  phone                 String?
  email                 String?
  address               String?
  telegramUrl           String?
  viberUrl              String?
  instagramUrl          String?
  youtubeUrl            String?
  facebookUrl           String?
  tiktokUrl             String?
  formTitle             String?
  formEnabled           Boolean  @default(true)
  formRecipientEmail    String?
  mapEmbedUrl           String?
  mapIframeHtml         String?  @db.Text
  additionalContentJson Json?
  additionalContentHtml String?  @db.Text
  seoTitle              String?
  seoDescription        String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

model ContactRequest {
  id        String               @id @default(cuid())
  firstName String
  lastName  String?
  email     String?
  phone     String?
  comment   String               @db.Text
  status    ContactRequestStatus @default(NEW)
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt

  @@index([status])
  @@index([createdAt])
}

model BlogCategory {
  id        String     @id @default(cuid())
  name      String
  slug      String     @unique
  sortOrder Int        @default(0)
  isActive  Boolean    @default(true)
  posts     BlogPost[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([isActive, sortOrder])
}

model BlogTag {
  id        String        @id @default(cuid())
  name      String
  slug      String        @unique
  isActive  Boolean       @default(true)
  posts     BlogPostTag[]
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([isActive])
}

model BlogPost {
  id                 String         @id @default(cuid())
  title              String
  slug               String         @unique
  excerpt            String?
  coverImage         String?
  coverImagePublicId String?
  contentJson        Json?
  contentHtml        String?        @db.Text
  authorName         String?
  readingTime        Int?
  viewsCount         Int            @default(0)
  status             BlogPostStatus @default(DRAFT)
  publishedAt        DateTime?
  categoryId         String?
  category           BlogCategory?  @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  tags               BlogPostTag[]
  seoTitle           String?
  seoDescription     String?
  seoImage           String?
  seoImagePublicId   String?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  @@index([status, publishedAt])
  @@index([categoryId])
}

model BlogPostTag {
  postId String
  tagId  String
  post   BlogPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  tag    BlogTag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([postId, tagId])
  @@index([tagId])
}

model FAQSection {
  id        String    @id @default(cuid())
  title     String
  slug      String    @unique
  sortOrder Int       @default(0)
  isActive  Boolean   @default(true)
  items     FAQItem[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([isActive, sortOrder])
}

model FAQItem {
  id         String     @id @default(cuid())
  sectionId  String
  section    FAQSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  question   String
  answerJson Json?
  answerHtml String?    @db.Text
  sortOrder  Int        @default(0)
  isActive   Boolean    @default(true)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  @@index([sectionId, sortOrder])
  @@index([isActive])
}

model Review {
  id             String     @id @default(cuid())
  type           ReviewType @default(STORE)
  productId      String?
  product        Product?   @relation(fields: [productId], references: [id], onDelete: SetNull)
  name           String
  initials       String?
  avatar         String?
  avatarPublicId String?
  rating         Int
  text           String     @db.Text
  isApproved     Boolean    @default(false)
  isActive       Boolean    @default(true)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  @@index([type, isApproved, isActive])
  @@index([productId])
  @@index([createdAt])
}

model CertificatePageSettings {
  id             String   @id @default(cuid())
  title          String   @default("Сертифікати відповідності")
  slug           String   @default("certificates")
  introJson      Json?
  introHtml      String?  @db.Text
  seoTitle       String?
  seoDescription String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model CertificateGroup {
  id              String            @id @default(cuid())
  name            String
  slug            String            @unique
  descriptionJson Json?
  descriptionHtml String?           @db.Text
  sortOrder       Int               @default(0)
  isActive        Boolean           @default(true)
  items           CertificateItem[]
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([isActive, sortOrder])
}

model CertificateItem {
  id                   String           @id @default(cuid())
  groupId              String
  group                CertificateGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  title                String
  previewImage         String?
  previewImagePublicId String?
  fileUrl              String?
  filePublicId         String?
  fileType             String?
  sortOrder            Int              @default(0)
  isActive             Boolean          @default(true)
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  @@index([groupId, sortOrder])
  @@index([isActive])
}

model ProductFieldValue {
  id           String                  @id @default(cuid())
  productId    String
  fieldId      String
  optionId     String?
  valueText    String?
  valueNumber  Decimal?                @db.Decimal(10, 2)
  valueBoolean Boolean?
  valueJson    Json?
  createdAt    DateTime                @default(now())
  updatedAt    DateTime                @updatedAt
  product      Product                 @relation(fields: [productId], references: [id], onDelete: Cascade)
  field        SubcategoryField        @relation(fields: [fieldId], references: [id], onDelete: Restrict)
  option       SubcategoryFieldOption? @relation(fields: [optionId], references: [id], onDelete: Restrict)

  @@unique([productId, fieldId])
  @@index([fieldId])
  @@index([optionId])
}

model Order {
  id                String          @id @default(cuid())
  userId            String?
  promoCodeId       String?
  status            OrderStatus     @default(NEW)
  paymentMethod     PaymentMethod
  email             String
  firstName         String
  lastName          String
  phone             String
  city              String
  addressLine1      String
  addressLine2      String?
  customerNote      String?         @db.Text
  subtotalAmount    Decimal         @db.Decimal(10, 2)
  discountAmount    Decimal         @default(0) @db.Decimal(10, 2)
  totalAmount       Decimal         @db.Decimal(10, 2)
  promoCodeSnapshot String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  user              User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  promoCode         PromoCode?      @relation(fields: [promoCodeId], references: [id], onDelete: SetNull)
  items             OrderItem[]
  promoCodeUsage    PromoCodeUsage?

  @@index([userId])
  @@index([promoCodeId])
  @@index([status])
  @@index([createdAt])
}

model OrderItem {
  id                    String   @id @default(cuid())
  orderId               String
  productId             String
  productTitle          String
  productSlug           String
  productImage          String?
  selectedOptions       Json?
  selectedOptionName    String?
  selectedOptionValue   String?
  selectedOptionValueId String?
  unitPrice             Decimal  @db.Decimal(10, 2)
  quantity              Int
  lineTotal             Decimal  @db.Decimal(10, 2)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  order                 Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product               Product  @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([productId])
  @@index([selectedOptionValueId])
}

model Address {
  id           String   @id @default(cuid())
  userId       String
  fullName     String?
  firstName    String
  lastName     String
  phone        String
  city         String
  address      String?
  comment      String?
  addressLine1 String
  addressLine2 String?
  label        String?
  isDefault    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model PromoCode {
  id             String                @id @default(cuid())
  code           String                @unique
  type           PromoCodeType         @default(GENERAL)
  discountType   PromoCodeDiscountType @default(PERCENT)
  percentValue   Decimal               @db.Decimal(5, 2)
  minOrderAmount Decimal               @default(500) @db.Decimal(10, 2)
  isActive       Boolean               @default(true)
  startsAt       DateTime?
  expiresAt      DateTime?
  assignedUserId String?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  assignedUser   User?                 @relation("AssignedPromoCodes", fields: [assignedUserId], references: [id], onDelete: SetNull)
  usages         PromoCodeUsage[]
  orders         Order[]

  @@index([assignedUserId])
  @@index([isActive])
}

model PromoCodeUsage {
  id          String    @id @default(cuid())
  promoCodeId String
  userId      String
  orderId     String
  createdAt   DateTime  @default(now())
  promoCode   PromoCode @relation(fields: [promoCodeId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  order       Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([promoCodeId, orderId])
  @@unique([orderId])
  @@index([userId])
}

model WishlistItem {
  id        String   @id @default(cuid())
  userId    String
  productId String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([userId])
  @@index([productId])
}
