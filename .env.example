# Vape Shop Platform environment reference.
# Copy required variables into .env and fill real secret values there.
# Do not commit real .env files with production credentials.

# Remote PostgreSQL connection used by Prisma at runtime.
# This project uses the remote Vercel/Prisma database, not a local PostgreSQL database.
DATABASE_URL="postgres://USER:PASSWORD@HOST:5432/postgres?sslmode=require"

# Direct PostgreSQL connection used by Prisma migrations and directUrl.
# For the current remote setup this can be the same value as DATABASE_URL.
DATABASE_POSTGRES_URL="postgres://USER:PASSWORD@HOST:5432/postgres?sslmode=require"

# Auth.js secret for signing sessions and tokens.
# Generate a long random value for every environment.
AUTH_SECRET="replace-with-long-random-secret"

# Public application origin used by Auth.js callbacks.
# Local development example: http://localhost:3000
# Production example: https://your-domain.com
AUTH_URL="http://localhost:3000"

# Optional seed admin values used only by `npm run prisma:seed`.
SEED_ADMIN_EMAIL="admin@voodoovape.local"
SEED_ADMIN_PASSWORD="Admin12345!"
SEED_ADMIN_FIRST_NAME="Voodoo"
SEED_ADMIN_LAST_NAME="Admin"

# Cloudinary customer environment values for product image upload.
CLOUDINARY_CLOUD_NAME="customer-cloud-name"
CLOUDINARY_API_KEY="customer-api-key"
CLOUDINARY_API_SECRET="customer-api-secret"

# Base folder for product image upload in Cloudinary.
# Current upload target: vape-shop/products/{product-slug}/image-{n}
CLOUDINARY_UPLOAD_FOLDER="vape-shop/products"
